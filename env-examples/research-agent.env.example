# Copy this file to .env and replace each placeholder with a real API key.
# This file is read by docker compose and injected into the LiteLLM container.
# NEVER commit .env to git.

# Primary free tiers (recommended first-fill)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional fallbacks / aggregators
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
REPORT_OUTPUT_DIR=
