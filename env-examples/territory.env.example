# Copy to .env (same directory as docker-compose.yml) to override any of these.
# Docker Compose loads this file automatically - it's entirely optional,
# every value below already has a sensible default baked into docker-compose.yml.

# Where the SQLite database is persisted on the NAS host. Point this at a
# folder on your main storage volume, e.g. /volume1/docker/territory/data
DATA_PATH=

# Ports exposed on the NAS host.
BACKEND_PORT=
FRONTEND_PORT=

DEFAULT_LIST_COUNT=

RESEARCH_ENABLED=
RESEARCH_INTERVAL_HOURS=

SOURCE_GOOGLE_NEWS_ENABLED=
SOURCE_GDELT_ENABLED=
SOURCE_PRESS_RELEASE_ENABLED=

# Off by default. Set to true and provide NEWSAPI_KEY to enable.
SOURCE_NEWSAPI_ENABLED=
NEWSAPI_KEY=

# Off by default. Set to true and provide ANTHROPIC_API_KEY to enable
# LLM-assisted signal classification/summaries instead of the keyword
# heuristic classifier.
ANTHROPIC_ENABLED=
ANTHROPIC_API_KEY=

REQUEST_DELAY_SECONDS=
